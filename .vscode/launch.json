{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Current File and Test Explorer",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "purpose": ["debug-in-terminal", "debug-test"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    },
    {
      "name": "Bronze tests",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": ["discover", "-v", "-s", "tests", "-p", "test_*.py", "-t", "."],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
